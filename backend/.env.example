# ─── Segurança ────────────────────────────────────────────
SECRET_KEY=troque-por-uma-chave-segura-de-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── App ──────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8000
FRONTEND_URL=http://localhost:5173

# ─── Links de afiliado ────────────────────────────────────
